# ============================================
# AdminCore 环境变量配置模板
# 复制此文件为 .env 并填入实际值（docker-compose 与后端共用）
# ============================================

# === 文件存储（默认 local；s3 兼容 AWS S3/MinIO，不自动迁移现有文件）===
ADMINCORE_STORAGE_BACKEND=local
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# AWS S3 可留空；MinIO 填独立服务地址
S3_ENDPOINT_URL=
S3_REGION_NAME=us-east-1
S3_LOCATION=admincore               # 专用非空前缀，备份恢复只操作此前缀
S3_ADDRESSING_STYLE=path
S3_ALLOW_INSECURE_HTTP=False         # 仅隔离开发 HTTP MinIO 使用 True；生产使用 HTTPS

# === Django 核心配置 ===
DJANGO_ENV=production               # development / production / testing
# 后端可信直接代理 IP/CIDR，逗号分隔；仅配置实际 Nginx 所在的隔离网络
ADMINCORE_TRUSTED_PROXIES=
FRONTEND_BIND_ADDRESS=127.0.0.1     # Tunnel/宿主 TLS 代理默认回环；直接公开时显式填写监听地址
FRONTEND_PORT=80
DJANGO_SECRET_KEY=your-secret-key-change-in-production  # 生产环境必须改
DJANGO_DEBUG=False                  # 开发环境：True，生产环境：False
# 默认仅控制台日志；Compose 每个容器 10 MiB × 3 自动轮转。
# 单进程宿主可选 True（10 MiB × 11）；多进程勿共享文件轮转。
DJANGO_FILE_LOGGING=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_LOG_LEVEL=INFO               # DEBUG / INFO / WARNING / ERROR
ADMINCORE_ADMIN_USERNAME=admin
# 首次生产初始化必填强密码，禁止演示密码；不会输出到日志
ADMINCORE_ADMIN_PASSWORD=
ADMINCORE_ADMIN_EMAIL=admin@example.com
ALLOW_PUBLIC_REGISTRATION=False     # 中后台默认关闭公开注册，由管理员创建用户
AUTH_SESSION_ABSOLUTE_SECONDS=86400 # 单设备绝对期限（秒），刷新不会延长
AUTH_SESSION_IDLE_SECONDS=1800      # 单设备空闲期限（秒）
AUTH_SESSION_TOUCH_SECONDS=60       # 最近API活动登记间隔（秒），至少60
# 可选 TOTP：使用独立 Fernet 密钥；留空不允许绑定，不会绕过已开启用户的认证。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 实际值只放环境配置，须与数据库备份分开保管；更换前须迁移加密数据。
AUTH_TOTP_ENCRYPTION_KEY=
# 企业 OIDC：仅完整构建且显式启用 sso 模块可用；默认不连接身份源。
# 固定 RS256/Authorization Code+PKCE；必须由管理员绑定 issuer/sub 到现有本地账号。
# 四个身份源 URL 必须同一公网 HTTPS 源；不做自动发现、不按邮箱自动绑定。
SSO_ISSUER=
SSO_AUTHORIZATION_ENDPOINT=
SSO_TOKEN_ENDPOINT=
SSO_JWKS_URI=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# 本站 HTTPS /api/v1/sso/callback/，须在身份源登记
SSO_REDIRECT_URI=
# 本站 HTTPS origin，不含路径/末尾斜杠
SSO_FRONTEND_ORIGIN=
# 独立 Fernet key，不能复用 JWT/TOTP 密钥
SSO_ENCRYPTION_KEY=
SSO_LABEL=企业身份登录
SSO_SESSION_SECONDS=3600            # 300–3600；SSO 会话绝对期限不续长
# 可选手机号加密：独立 Fernet key，不能复用 TOTP/JWT 密钥；与数据库备份分开保管。
# key存在即加密全部非空ORM写入；ENABLED=True要求启动时有有效key。
# 关闭开关但保留key仍加密；移除key后已有密文不可读，不支持自动解密降级。
ADMINCORE_FIELD_ENCRYPTION_ENABLED=False
ADMINCORE_FIELD_ENCRYPTION_KEY=
TRUSTED_PROXY_IP=127.0.0.1          # 仅填写直接连接前端 Nginx 的可信 HTTPS 网关 IP；默认不信任外部协议头
BACKEND_BIND_ADDRESS=127.0.0.1      # 后端端口仅限本机，公网流量经前端 Nginx
USE_TLS=False                      # 仅在外置 HTTPS 网关就绪后启用
SECURE_HSTS_SECONDS=0              # HTTPS 域名完成验证后逐步增加

# === 数据库配置（compose 内 DB_HOST 固定为 db，本地开发为 localhost） ===
DB_NAME=admincore
DB_USER=postgres
DB_PASSWORD=postgres                # 生产环境必须改强密码
DB_HOST=localhost
DB_PORT=5432
# 通用列表和数据导出的单条 SQL/单次锁等待预算（毫秒），不得为 0。
ADMINCORE_QUERY_STATEMENT_TIMEOUT_MS=30000
ADMINCORE_QUERY_LOCK_TIMEOUT_MS=2000

# === Redis / Celery（compose 内主机名固定为 redis） ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === 文件上传（对应 settings：FILE_UPLOAD_*） ===
FILE_UPLOAD_MAX_SIZE=52428800       # 50MB
FILE_SOFT_DELETE_RETENTION_DAYS=30  # 软删除文件保留天数
ADMINCORE_IMAGE_PROCESSING_ENABLED=False  # 缩略/压缩/图片水印，需 file:process + file:download
# Office 预览需完整构建、files/tasks 模块，以及受信任宿主启动独立沙箱执行器。
# 固定审核过的 image@sha256 摘要；Web/worker 不挂载 Docker socket。见 docs/OFFICE_PREVIEW.md。
ADMINCORE_OFFICE_PREVIEW_ENABLED=False
ADMINCORE_OFFICE_IMAGE=
NOTIFICATION_RETENTION_DAYS=90      # 已读通知保留天数

# === 自动停写备份（默认关闭；必须先启动受信任宿主 scripts/backup_runner.py）===
ADMINCORE_BACKUP_ENABLED=False
ADMINCORE_BACKUP_RETENTION_DAYS=30  # 超出天数且超出最少份数，才回收已校验的执行器备份
ADMINCORE_BACKUP_RETENTION_COUNT=7
# 独立私有 S3 备份桶；与媒体凭据分离。留空只保留宿主 BACKUP_DIR，不代表异地备份。
ADMINCORE_BACKUP_S3_BUCKET=
ADMINCORE_BACKUP_S3_PREFIX=admincore-backups
ADMINCORE_BACKUP_S3_ENDPOINT=
ADMINCORE_BACKUP_S3_REGION=us-east-1
ADMINCORE_BACKUP_S3_ACCESS_KEY=
ADMINCORE_BACKUP_S3_SECRET_KEY=
ADMINCORE_BACKUP_S3_ALLOW_HTTP=False # 只用于隔离 MinIO 验收；生产 HTTPS

# === 前端构建（本地开发时 Vite 代理目标） ===
VITE_API_BASE_URL=/api/v1
# API版本生命周期：默认v1正常使用；配置需重启Python服务，至少90天兼容期。
# 完整格式与发布流程见 docs/API版本与废弃流程-2026-10-15.md，日期到达不自动删除接口。
ADMINCORE_API_LIFECYCLE={}

# 可选 SSE：默认预设均不启用。按 docs/实时通道-2026-10-15.md 叠加 compose.realtime.yml。
# 已显式设置 ADMINCORE_MODULES 的部署需将 realtime 加入列表；精简仅使用 realtime 可不装 Redis。
# ADMINCORE_MODULES=realtime

# === CORS 跨域（本地开发直连后端时使用） ===
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# === 基础镜像版本（与 版本要求.md 一致，仅作记录） ===
POSTGRES_VERSION=18.6
REDIS_VERSION=8.10.2
# 邮箱归属验证与密码找回：默认关闭；standard 中由 core.dispatch_outbox 定时可靠派发。
# minimal 默认无 Redis/worker/beat，因此入口不可用。请使用专用 SMTP 账户，真实凭据不进 Git。
AUTH_EMAIL_ENABLED=False
NOTIFICATION_EMAIL_ENABLED=False
# 可选 webhook/Twilio 短信静态部署配置；默认关闭，真实密钥不得提交。
# 结构及收件人核验要求见 docs/外部通知渠道与验收-2026-10-16.md。
ADMINCORE_NOTIFICATION_EXTERNAL_CHANNELS_JSON={}
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=
# 登录失败后图形验证码门槛，使用数据库共享计数；验证码仍受原登录限流与双因素约束。
AUTH_LOGIN_CAPTCHA_ENABLED=False
AUTH_LOGIN_CAPTCHA_FAILURE_THRESHOLD=3
