{
  "schema_version": 2,
  "module": "cg_suppliers",
  "model": "Supplier",
  "title": "供应商",
  "structure": "single",
  "fields": [
    {
      "name": "code",
      "label": "供应商编码",
      "kind": "string",
      "max_length": 40,
      "unique": true,
      "query": "eq",
      "sortable": true
    },
    {
      "name": "name",
      "label": "供应商名称",
      "kind": "string",
      "max_length": 120,
      "query": "contains",
      "indexed": true
    },
    {
      "name": "active",
      "label": "启用",
      "kind": "boolean",
      "default": true,
      "query": "eq"
    }
  ]
}
