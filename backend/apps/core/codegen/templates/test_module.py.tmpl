def test_crud_and_conflict(admin_client):
    first = admin_client.post(URL, payload(), format='json', HTTP_IDEMPOTENCY_KEY='generated-once')
    assert first.status_code == 201
    repeated = admin_client.post(URL, payload(), format='json', HTTP_IDEMPOTENCY_KEY='generated-once')
    assert repeated.status_code == 201 and first.json() == repeated.json()
    identifier = first.json()['data']['id']
    detail = URL + identifier + '/'
    assert admin_client.patch(detail, {'version': 0}, format='json').status_code == 409
    assert admin_client.patch(detail, {'version': 1}, format='json').status_code == 200
    assert admin_client.delete(detail, {'version': 1}, format='json').status_code == 409
    assert admin_client.delete(detail, {'version': 2}, format='json').status_code == 200
    assert OperationLog.objects.filter(resource='@@MODULE@@', resource_id=identifier).count() == 3


def test_permissions_and_owner_scope(member_client, member_user, admin_user):
    assert member_client.get(URL).status_code == 403
    role = Role.objects.create(name='generated-reader')
    UserRole.objects.create(user=member_user, role=role)
    permission, _ = Permission.objects.get_or_create(resource='@@MODULE@@', action='read', defaults={'name': 'read', 'code': '@@MODULE@@:read'})
    RolePermission.objects.create(role=role, permission=permission)
    mine = @@MODEL@@.objects.create(creator=member_user, **{key: value for key, value in payload().items() if key != 'version'})
    other = @@MODEL@@.objects.create(creator=admin_user, **{key: value for key, value in payload().items() if key != 'version'})
    assert [row['id'] for row in member_client.get(URL).json()['data']['items']] == [str(mine.pk)]
    assert member_client.get(URL + str(other.pk) + '/').status_code == 404
    assert member_client.post(URL, payload(), format='json').status_code == 403


def test_list_query_contract(admin_client):
    for query in ['?unknown=1', '?ordering=creator__username', '?page=1&page=2',
                  '?ordering=created_at,-created_at']:
        assert admin_client.get(URL + query).status_code == 400
    assert admin_client.get(URL, {'ordering': '-created_at', 'page_size': 2}).status_code == 200


def test_write_whitelist_and_audit_rollback(admin_client, settings):
    assert admin_client.post(URL, {**payload(), 'creator': 'spoof'}, format='json').status_code == 400
    with patch('apps.@@MODULE@@.services.write_audit', side_effect=RuntimeError('isolated audit fixture')):
        assert admin_client.post(URL, payload(), format='json').status_code == 500
    assert not @@MODEL@@.objects.exists()
    settings.ADMINCORE_MODULES = tuple(key for key in settings.ADMINCORE_MODULES if key != '@@MODULE@@')
    assert admin_client.get(URL).status_code == 404
