<template>
  <AppLayout><BaseCard>
    <template #header><div class="header"><h2>{{ uiText(title) }}</h2><BaseButton v-if="auth.can(resource + ':create')" variant="primary" :disabled="busy" @click="edit()">{{ uiText('新增') }}</BaseButton></div></template>
    <div class="filters"><el-input v-model="search" :aria-label="uiText('搜索')" maxlength="120" clearable @keyup.enter="searchRows" /><BaseButton :disabled="busy || loading" @click="searchRows">{{ uiText('搜索') }}</BaseButton><BaseButton :disabled="busy || loading" @click="loadRows">{{ uiText('刷新') }}</BaseButton></div>
    <el-alert v-if="loadError" :title="uiText('列表加载失败，请刷新重试')" type="error" :closable="false" />
    <BaseTable :data="rows" :columns="columns" :loading="loading" :total="total" :current-page="page" :page-size="pageSize" :action-width="240" @update:currentPage="changePage" @update:pageSize="changeSize">
      <template #actions="{ row }"><el-button link :disabled="busy" @click="inspect(row)">{{ uiText('详情') }}</el-button><el-button v-if="auth.can(resource + ':update')" link :disabled="busy" @click="edit(row)">{{ uiText('编辑') }}</el-button><el-button v-if="auth.can(resource + ':delete')" link type="danger" :disabled="busy" @click="remove(row)">{{ uiText('删除') }}</el-button></template>
    </BaseTable>
  </BaseCard>
  <BaseDialog v-model="opened" :title="uiText(title)" width="600px" :loading="formBusy" :confirm-disabled="conflict.active.value" :before-close="guard.confirmDiscard" :confirm-text="uiText('保存')" @confirm="save">
    <p v-if="error" role="alert" class="form-error">{{ error }}</p>
    <EditConflictPanel v-if="conflict.active.value" :loading="conflict.loading.value" :failed="conflict.failed.value" :disabled="saving || !guard.isCurrent()" :version="form.version" :server-version="conflict.latest.value?.version" :rows="conflictRows" @inspect="conflict.inspect" @apply="conflict.applyLatest" />
    <el-form :model="form" :disabled="formBusy" label-position="top" @submit.prevent="save">
      <el-form-item v-for="field in fields" :key="field.name" :label="uiText(field.label)" :required="field.required">
        <el-input v-if="field.kind === 'string' || field.kind === 'text'" :model-value="String(form[field.name] ?? '')" @update:model-value="form[field.name] = $event" :type="field.kind === 'text' ? 'textarea' : 'text'" :rows="4" :maxlength="field.max_length" :aria-label="uiText(field.label)" />
        <el-input-number v-else-if="field.kind === 'integer'" :model-value="typeof form[field.name] === 'number' ? form[field.name] as number : undefined" @update:model-value="form[field.name] = $event" :min="field.minimum" :max="field.maximum" :precision="0" :aria-label="uiText(field.label)" />
        <el-switch v-else :model-value="Boolean(form[field.name])" @update:model-value="form[field.name] = $event" :aria-label="uiText(field.label)" />
      </el-form-item>
    </el-form>
  </BaseDialog>
  <BaseDialog v-model="detailOpen" :title="uiText('详情')" width="600px" :show-cancel="false" :confirm-text="uiText('关闭')" @confirm="detailOpen = false" @close="selected = null"><dl v-if="selected"><template v-for="field in fields" :key="field.name"><dt>{{ uiText(field.label) }}</dt><dd>{{ selected[field.name] }}</dd></template><dt>{{ uiText('版本') }}</dt><dd>{{ selected.version }}</dd></dl></BaseDialog>
  </AppLayout>
</template>

<script setup lang="ts">
import { computed, onBeforeUnmount, reactive, ref, watch } from 'vue'
import { ElMessage, ElMessageBox } from 'element-plus'
import { BaseButton, BaseCard, BaseDialog, BaseTable } from '@/components'
import AppLayout from '@/components/layout/AppLayout.vue'
import request, { responseStatus, type ApiResponse } from '@/api/request'
import { newIdempotencyKey } from '@/api'
import { useAuthStore } from '@/stores/auth'
import { useModuleStore } from '@/stores/modules'
import { useUnsavedChanges } from '@/composables/useUnsavedChanges'
import { useErrorSummary } from '@/composables/useErrorSummary'
import { useEditConflict } from '@/composables/useEditConflict'
import EditConflictPanel from '@/components/common/EditConflictPanel.vue'
import { uiText } from '@/i18n/uiText'

const resource = '@@MODULE@@', title = @@TITLE_JSON@@, fields = @@FRONTEND_FIELDS@@
const endpoint = '/@@API_PREFIX@@/records/'
interface Row { id: string; version: number; creator_name: string; [key: string]: unknown }
const auth = useAuthStore(), modules = useModuleStore()
const rows = ref<Row[]>([]), total = ref(0), page = ref(1), pageSize = ref(10), search = ref(''), appliedSearch = ref('')
const loading = ref(false), loadError = ref(false), opened = ref(false), detailOpen = ref(false), selected = ref<Row | null>(null)
const saving = ref(false), removing = ref(false), error = ref('')
const formBusy = computed(() => saving.value || conflict.loading.value), busy = computed(() => formBusy.value || removing.value)
const initial = (): { id: string; version: number; [key: string]: unknown } => ({ ...@@DEFAULTS@@, id: '', version: 0 })
const form = reactive(initial())
let generation = 0, alive = true, key = '', submitted = ''
const canRead = () => auth.can(resource + ':read') && modules.enabled(resource)
const guard = useUnsavedChanges({ source: () => form, active: () => opened.value, busy: () => formBusy.value,
  canEdit: () => canRead() && auth.can(resource + (form.id ? ':update' : ':create')),
  clear: () => { opened.value = false; Object.assign(form, initial()); error.value = ''; key = ''; submitted = '' } })
const conflict = useEditConflict<Row>({ identifier: () => opened.value ? form.id : '', current: () => guard.isCurrent(),
  fetch: async (id, signal) => (await request.get<ApiResponse<Row>>(endpoint + id + '/', { signal })).data.data,
  apply: row => { for (const field of fields) form[field.name] = row[field.name]; form.version = row.version; error.value = ''; key = newIdempotencyKey(resource); submitted = ''; guard.markClean() } })
const conflictRows = computed(() => {
  const server = conflict.latest.value
  if (!server) return []
  return fields.map(field => ({ label: uiText(field.label),
    local: field.kind === 'boolean' ? uiText(form[field.name] ? '是' : '否') : String(form[field.name] ?? ''),
    server: field.kind === 'boolean' ? uiText(server[field.name] ? '是' : '否') : String(server[field.name] ?? '') }))
})
const actionGuard = useUnsavedChanges({ source: () => null, busy: () => removing.value, canEdit: () => canRead() && auth.can(resource + ':delete'), clear: () => {} })
useErrorSummary(error)
const columns = computed(() => [...fields.map(field => ({ prop: field.name, label: uiText(field.label), width: field.kind === 'text' ? 280 : 160,
  render: (value: unknown) => field.kind === 'boolean' ? uiText(value ? '是' : '否') : String(value ?? '') })),
  { prop: 'creator_name', label: uiText('创建者'), width: 140 }, { prop: 'version', label: uiText('版本'), width: 80 }])
async function loadRows() {
  const current = ++generation; rows.value = []; total.value = 0; loadError.value = false
  if (!canRead()) return
  loading.value = true
  try { const response = await request.get<ApiResponse<{ items: Row[]; pagination: { total: number } }>>(endpoint, { params: { page: page.value, page_size: pageSize.value, search: appliedSearch.value } }); if (alive && current === generation && canRead()) { rows.value = response.data.data.items; total.value = response.data.data.pagination.total } }
  catch { if (alive && current === generation && canRead()) loadError.value = true }
  finally { if (alive && current === generation) loading.value = false }
}
function searchRows() { page.value = 1; appliedSearch.value = search.value.trim(); void loadRows() }
function changePage(value: number) { page.value = value; void loadRows() }
function changeSize(value: number) { page.value = 1; pageSize.value = value; void loadRows() }
function edit(row?: Row) { if (busy.value || !canRead() || !auth.can(resource + (row ? ':update' : ':create'))) return; Object.assign(form, initial()); if (row) { for (const field of fields) form[field.name] = row[field.name]; form.id = row.id; form.version = row.version } error.value = ''; conflict.reset(); key = newIdempotencyKey(resource); submitted = ''; opened.value = true }
function inspect(row: Row) { if (canRead()) { selected.value = { ...row }; detailOpen.value = true } }
async function save() {
  if (busy.value || conflict.active.value || !guard.isCurrent()) return
  const payload: Record<string, unknown> = { version: form.version }
  for (const field of fields) { const value = form[field.name]; payload[field.name] = typeof value === 'string' ? value.trim() : value; if ((field.kind === 'string' || field.kind === 'text') && field.required && !String(payload[field.name] ?? '')) { error.value = uiText('必填字段不能为空'); return } }
  const digest = JSON.stringify(payload); if (submitted && submitted !== digest) key = newIdempotencyKey(resource)
  submitted = digest; saving.value = true; error.value = ''
  try { if (form.id) await request.patch(endpoint + form.id + '/', payload); else await request.post(endpoint, payload, { headers: { 'Idempotency-Key': key } }); if (!guard.isCurrent()) return; guard.markClean(); opened.value = false; ElMessage.success(uiText('保存成功')); await loadRows() }
  catch (failure: unknown) { if (!guard.isCurrent()) return; if (responseStatus(failure) === 409 && form.id) conflict.mark(); else error.value = uiText('保存失败，输入已保留；请检查字段或刷新选项后重试') }
  finally { saving.value = false }
}
async function remove(row: Row) {
  if (busy.value || !actionGuard.isCurrent()) return
  removing.value = true
  try { await ElMessageBox.confirm(uiText('确定删除？'), uiText('提示')); if (!actionGuard.isCurrent()) return; await request.delete(endpoint + row.id + '/', { data: { version: row.version } }); if (!actionGuard.isCurrent()) return; if (rows.value.length === 1 && page.value > 1) page.value--; await loadRows() }
  catch (failure) { if (actionGuard.isCurrent() && failure !== 'cancel' && failure !== 'close') ElMessage.warning(uiText('删除未确认，请刷新检查版本和状态')) }
  finally { removing.value = false }
}
watch(() => [auth.user?.id, auth.can(resource + ':read'), modules.enabled(resource)], () => { generation++; rows.value = []; total.value = 0; selected.value = null; detailOpen.value = false; if (canRead()) void loadRows() })
onBeforeUnmount(() => { alive = false; generation++; rows.value = []; selected.value = null })
void loadRows()
</script>

<style scoped>
.header, .filters { display: flex; align-items: center; gap: var(--spacing-sm); flex-wrap: wrap; }
.header { justify-content: space-between; } h2 { margin: 0; font-size: var(--font-size-lg); }
.filters { margin-bottom: var(--spacing-md); } .filters :deep(.el-input) { max-width: 320px; }
.form-error { color: var(--el-color-danger); overflow-wrap: anywhere; }
dt { color: var(--color-text-secondary); } dd { margin: var(--spacing-xs) 0 var(--spacing-md); overflow-wrap: anywhere; white-space: pre-wrap; }
@media (max-width: 640px) { .filters :deep(.el-input) { flex-basis: 100%; max-width: 100%; } }
</style>
