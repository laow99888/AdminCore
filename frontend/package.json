{
  "name": "admincore-frontend",
  "version": "1.0.0",
  "description": "AdminCore 中后台管理系统前端框架",
  "type": "module",
  "scripts": {
    "sdk:generate": "node scripts/generate-sdk.mjs",
    "sdk:check": "node scripts/generate-sdk.mjs --check",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:typecheck": "vue-tsc --noEmit -p tsconfig.test.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/vue-3": "3.32.0",
    "axios": "1.20.0",
    "dayjs": "1.11.23",
    "dompurify": "3.4.17",
    "echarts": "6.1.0",
    "element-plus": "2.14.7",
    "lucide-vue-next": "1.0.0",
    "pdfjs-dist": "6.4.299",
    "pinia": "3.0.4",
    "qiankun": "2.10.16",
    "vue": "3.5.44",
    "vue-i18n": "11.4.14",
    "vue-router": "4.6.4",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "autoprefixer": "10.6.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "sass": "1.105.1",
    "terser": "5.51.2",
    "typescript": "5.9.3",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  }
}
